{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Ciclo de Vida — Inventory Run",
    "output": "lifecycle.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-path",
        "label": "Camino principal",
        "focus": ["queued", "running", "completed"],
        "note": "El run avanza de cola a ejecución y termina completado cuando todos los colectores finalizan."
      },
      {
        "id": "cancel-exit",
        "label": "Cancelación y fallo",
        "focus": ["running", "cancel_wait", "cancelled", "failed"],
        "note": "POST /cancel registra la señal; el loop la detecta y termina el run. Una excepción no controlada produce failed."
      }
    ]
  },
  "lanes": [
    { "id": "main",     "label": "Ciclo principal" },
    { "id": "waiting",  "label": "Espera" },
    { "id": "terminal", "label": "Salidas terminales" }
  ],
  "states": [
    {
      "id": "queued",
      "type": "start",
      "label": "Queued",
      "sublabel": "run_id generado",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "entrada"
    },
    {
      "id": "running",
      "type": "active",
      "label": "Running",
      "sublabel": "recolectando AWS",
      "lane": "main",
      "col": 2,
      "step": "02",
      "tag": "trabajo"
    },
    {
      "id": "completed",
      "type": "success",
      "label": "Completed",
      "sublabel": "recursos persistidos",
      "lane": "main",
      "col": 4,
      "step": "03",
      "tag": "éxito"
    },
    {
      "id": "cancel_wait",
      "type": "waiting",
      "label": "Cancel Requested",
      "sublabel": "señal registrada",
      "lane": "waiting",
      "col": 1,
      "tag": "señal"
    },
    {
      "id": "cancelled",
      "type": "failure",
      "label": "Cancelled",
      "sublabel": "detenido",
      "lane": "terminal",
      "col": 0,
      "tag": "terminal"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "excepción",
      "lane": "terminal",
      "col": 2,
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "id": "queued-running",
      "from": "queued",
      "to": "running",
      "label": "background task inicia"
    },
    {
      "id": "running-completed",
      "from": "running",
      "to": "completed",
      "label": "save_many() ok",
      "variant": "emphasis",
      "channelY": 100
    },
    {
      "id": "running-cancel",
      "from": "running",
      "to": "cancel_wait",
      "label": "POST /cancel",
      "variant": "security"
    },
    {
      "id": "cancel-cancelled",
      "from": "cancel_wait",
      "to": "cancelled",
      "label": "loop detecta flag",
      "labelAt": [401, 420]
    },
    {
      "id": "running-failed",
      "from": "running",
      "to": "failed",
      "label": "excepción",
      "variant": "security",
      "channelY": 210,
      "channelX": 860
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Flujo normal",
      "items": [
        "API crea el run en queued y retorna run_id al instante",
        "Background task actualiza a running antes de recolectar",
        "completed se alcanza cuando todos los recursos están persistidos"
      ]
    },
    {
      "dot": "amber",
      "title": "Cancelación cooperativa",
      "items": [
        "POST /{run_id}/cancel registra señal en CancellationRegistry",
        "El loop entre cuentas comprueba la señal en cada iteración",
        "El run termina cancelled con los recursos recolectados hasta ese punto"
      ]
    },
    {
      "dot": "rose",
      "title": "Fallo",
      "items": [
        "Una excepción no controlada en el background task marca failed",
        "El mensaje de error queda en metadata del run (máx. 500 chars)",
        "Los errores por colector individual no abortan el run completo"
      ]
    }
  ]
}
