# Required by docker-compose.yml. Do not commit real values to .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
INVENTORY_READ_API_KEY=replace-with-a-random-read-key
INVENTORY_WRITE_API_KEY=replace-with-a-random-write-key
# Optional deployment guard. Leave empty to allow the caller's own AWS account.
INVENTORY_ALLOWED_ACCOUNT_IDS=
