# No configuration is needed for the local stack: it listens only on localhost.
# The following values are only for a public/server deployment. Do not commit real values.
# POSTGRES_PASSWORD=replace-with-a-long-random-password
# INVENTORY_API_AUTH_REQUIRED=true
# INVENTORY_READ_API_KEY=replace-with-a-random-read-key
# INVENTORY_WRITE_API_KEY=replace-with-a-random-write-key
# Optional deployment guard. Leave empty to allow the caller's own AWS account.
INVENTORY_ALLOWED_ACCOUNT_IDS=
