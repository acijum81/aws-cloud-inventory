# Required by docker-compose.yml. Do not commit real values to .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
AWS_ACCESS_KEY_ID=replace-with-an-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-an-aws-secret-access-key
# Leave empty unless the credentials are temporary STS credentials.
AWS_SESSION_TOKEN=
INVENTORY_READ_API_KEY=replace-with-a-random-read-key
INVENTORY_WRITE_API_KEY=replace-with-a-random-write-key
INVENTORY_ALLOWED_ACCOUNT_IDS=123456789012
